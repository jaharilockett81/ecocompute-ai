# --- Nebius Token Factory (required for real inference) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Verify these IDs with: python scripts/verify_nebius.py
NEBIUS_MODEL_SMALL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_MEDIUM=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_LARGE=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_ROUTER_MODEL=
NEBIUS_JUDGE_MODEL=
# USD per 1M tokens. Values below are from third-party catalog listings — VERIFY on the Token Factory pricing page.
NEBIUS_PRICE_IN_SMALL=0.06
NEBIUS_PRICE_OUT_SMALL=0.24
NEBIUS_PRICE_IN_MEDIUM=0.30
NEBIUS_PRICE_OUT_MEDIUM=0.90
NEBIUS_PRICE_IN_LARGE=1.00
NEBIUS_PRICE_OUT_LARGE=3.00

# --- Guardrails ---
ECOCOMPUTE_DAILY_BUDGET_USD=5
ECOCOMPUTE_MAX_WORKLOAD_COST_USD=0.05
ECOCOMPUTE_BENCHMARK_MAX_CALLS=400
ECOCOMPUTE_MAX_OUTPUT_TOKENS=2048
ECOCOMPUTE_RATE_LIMIT_PER_MINUTE=12
ECOCOMPUTE_DEMO_ACCESS_CODE=
ECOCOMPUTE_CORS_ORIGINS=http://localhost:3000
ECOCOMPUTE_ENABLE_CODE_EXECUTION=true
ECOCOMPUTE_MIN_START_PASS=0.5
ECOCOMPUTE_EXPLORATION_RATE=0
